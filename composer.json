{
    "name": "huement/statamic-ytlistr",
    "description": "Statamic addon for syncing YouTube videos to a local database",
    "type": "statamic-addon",
    "license": "MIT",
    "authors": [
        {
            "name": "Huement",
            "email": "info@huement.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "statamic/cms": "^5.0 || ^6.0"
    },
    "autoload": {
        "psr-4": {
            "Huement\\StatamicYtListr\\": "src/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.8",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Huement\\StatamicYtListr\\Tests\\": "tests/"
        }
    },
    "extra": {
        "statamic": {
            "name": "YouTube Listr",
            "description": "Sync YouTube videos to your Statamic site"
        },
        "laravel": {
            "providers": [
                "Huement\\StatamicYtListr\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    }
}
